# Copy to config/deploy.env (gitignored) and fill in. Secrets do NOT go here: they live in
# Secret Manager (see README "Secrets").

# Google Cloud / Firebase project id (same project for both).
PROJECT_ID=your-project-id
REGION=europe-north1
# Cloud Scheduler is not offered in europe-north1; the triggers live here and start the job in REGION.
SCHEDULER_REGION=europe-west1

# Your Firebase Auth uid (Firebase console > Authentication > Users, after your first sign-in).
OWNER_UID=

# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
FIREBASE_API_KEY=
FIREBASE_APP_ID=

# Public URL of the Cloud Run service (printed by the first `npm run deploy:api`). Used for alert links.
APP_URL=

# Market data routing. EODHD does not cover the Tokyo Stock Exchange; Yahoo does.
MARKET_DATA_PROVIDER=eodhd
MARKET_DATA_PROVIDER_TSE=yahoo
FX_PROVIDER=eodhd
CRYPTO_HISTORY_PROVIDER=eodhd

# Alerts by email through Resend. With onboarding@resend.dev, Resend only delivers to your own
# Resend account address; verify a domain to send from your own address.
ALERT_TO=
ALERT_FROM="Premium Watch <onboarding@resend.dev>"

# Every 30 minutes during trading hours. Off by default.
INTRADAY_ENABLED=false

# Holdings job on this Mac (ops/update-holdings.sh). SEC refuses requests without a real
# contact: https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="Your Name you@example.com"
